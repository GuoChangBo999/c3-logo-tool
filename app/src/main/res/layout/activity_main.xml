<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C3 超级投屏"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="comma 3 / 3X 低延迟投屏 + 双向触控反控"
            android:textSize="12sp"
            android:alpha="0.7" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="车机 IP"
            android:inputType="text"
            android:text="10.90.179.222" />
        <EditText
            android:id="@+id/etSshUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="SSH 用户名"
            android:inputType="text"
            android:text="comma" />

        <EditText
            android:id="@+id/etSshPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="SSH 密码（无密钥时使用）"
            android:inputType="textPassword"
            android:text="comma" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etVideoPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="视频端口"
                android:inputType="number"
                android:text="5000" />
            <EditText
                android:id="@+id/etTouchPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="触控端口"
                android:inputType="number"
                android:text="27184" />
        </LinearLayout>

        <!-- ===== SSH key auth ===== -->
        <CheckBox
            android:id="@+id/cbUseKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="使用 SSH 私钥认证（优先于密码）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnPickKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="从文件选择私钥" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:alpha="0.6"
                android:textSize="11sp"
                android:text="支持 id_rsa / id_ed25519" />
        </LinearLayout>

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="4dp"
            android:gravity="top|start"
            android:hint="-----BEGIN OPENSSH PRIVATE KEY----- ...（粘贴私钥内容）"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/etKeyPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="私钥密码（passphrase，可留空）"
            android:inputType="textPassword" />

        <CheckBox
            android:id="@+id/cbDeploy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="连接前自动部署车机端（上传并安装 c3-screen-v2）" />

        <Button
            android:id="@+id/btnDeploy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="仅部署车机端" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="开始投屏" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="" />
    </LinearLayout>
</ScrollView>